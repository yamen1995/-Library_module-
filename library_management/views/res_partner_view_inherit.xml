<odoo>
  <record id="view_partner_form_library_member" model="ir.ui.view">
    <field name="name">res.partner.form.library.member</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- Add Card ID field below Job Position -->
<xpath expr="//notebook" position="inside">
  <page string="Library Info" invisible="not is_library_member">
    <group>
      <field name="card_id" readonly="1"/>
      <field name="membership_count" readonly="1"/>
      <field name="member_since"/>
    </group>

    <notebook>
      <page string="Current Books">
        <field name="books_borrowed" widget="many2many_tags"/>
      </page>
      <page string="Late Fees">
        <field name="late_fees"/>
      </page>
      <page string="Borrow History">
        <field name="borrow_record_ids">
          <list editable="bottom">
            <field name="book_id"/>
            <field name="borrow_date"/>
            <field name="return_date"/>
            <field name="borrow_state"/>
          </list>
        </field>
      </page>
    </notebook>
  </page>
</xpath>
      <!-- Add Smart Button only for library members -->
      <xpath expr="//div[@class='oe_button_box']" position="inside">
        <button name="action_view_memberships"
                type="object"
                class="oe_stat_button"
                icon="fa-id-card"
                invisible="not is_library_member">
          <field name="membership_count" widget="statinfo" string="Memberships"/>
        </button>
      </xpath>

    </field>
  </record>
  <record id="view_partner_filter_library_member" model="ir.ui.view">
  <field name="name">res.partner.search.library.member</field>
  <field name="model">res.partner</field>
  <field name="inherit_id" ref="base.view_res_partner_filter"/>
  <field name="arch" type="xml">
    <xpath expr="//filter[@name='customer']" position="after">
      <filter name="library_member"
              string="Library Members"
              domain="[('is_library_member','=',True)]"/>
    </xpath>
  </field>
</record>

  <record id="action_library_members" model="ir.actions.act_window">
    <field name="name">Members</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_library_member', '=', True)]</field>
    <field name="context">{'default_is_library_member': 1}</field>
  </record>

</odoo>