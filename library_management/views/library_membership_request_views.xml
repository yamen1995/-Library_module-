<odoo>
<record id="action_membership_request_mass_print" model="ir.actions.server">
    <field name="name">Print Selected Membership Requests</field>
    <field name="model_id" ref="model_library_membership_request"/>
    <field name="binding_model_id" ref="model_library_membership_request"/>
    <field name="binding_type">action</field>
    <field name="state">code</field>
    <field name="code">
        action = env['library.membership.request'].browse(env.context.get('active_ids')).print_membership_request()
    </field>
</record>

<record id="action_membership_request_print_all" model="ir.actions.server">
    <field name="name">Print All Membership Requests</field>
    <field name="model_id" ref="model_library_membership_request"/>
    <field name="state">code</field>
    <field name="code">
        action = env['library.membership.request'].search([]).print_membership_request()
    </field>
</record>

  <record id="view_library_membership_request_tree" model="ir.ui.view">
    <field name="name">library.membership.request.tree</field>
    <field name="model">library.membership.request</field>
    <field name="arch" type="xml">
      <list string="Membership Requests">
       <header>
       <button name="print_membership_request" string="Print Selected" type="object" />
       <button name="%(action_membership_request_print_all)d" string="Print All" type="action" class="oe_highlight"/>
       </header>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="request_date"/>
        <field name="status"/>
        <button name="print_membership_request"
            type="object"
            string="Print Membership Report"
            class="btn-primary"/>
      </list>
    </field>
  </record>

  <record id="view_library_membership_request_form" model="ir.ui.view">
    <field name="name">library.membership.request.form</field>
    <field name="model">library.membership.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" string="Confirm" type="object" invisible="status != 'draft'"/>
          <button name="action_generate_invoice" string="Generate Invoice" type="object" invisible="status != 'confirmed'"/>
          <button name="action_activate" string="Activate" type="object" invisible="status != 'paid'"/>
          <button name="print_membership_request"
            type="object"
            string="Print Membership Report"
            class="btn-primary"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,paid,active"/>
        </header>
        <sheet>
          <group>
            <field name="partner_id"/>
            <field name="request_date"/>
            <field name="end_date"/>
            <field name="card_id"/>
            <field name="payment_term_id"/>
            <field name="invoice_id"/>
          </group>

          <notebook>
            <page string="Membership Line">
              <field name="membership_line_ids">
                <list editable="bottom">
                  <field name="product_id" domain="[('is_library_membership','=',True)]"/>
                  <field name="price_unit"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

   <!-- Action: Membership Requests -->
  <record id="action_membership_requests" model="ir.actions.act_window">
  <field name="name">Membership Requests</field>
  <field name="res_model">library.membership.request</field>
  <field name="view_mode">list,form</field>
  <field name="view_id" ref="view_library_membership_request_tree"/>
</record>

  <!-- Action: Invoices related to Memberships -->
  <record id="action_library_membership_invoices" model="ir.actions.act_window">
    <field name="name">Membership Invoices</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('invoice_origin', 'ilike', 'Membership')]</field>
  </record>

</odoo>