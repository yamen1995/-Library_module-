<odoo>
<!-- views for membership request model  -->
  <record id="view_library_membership_request_form" model="ir.ui.view">
    <field name="name">library.membership.request.form</field>
    <field name="model">library.membership.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" string="Confirm" type="object" invisible="status != 'draft'"/>
          <button name="action_generate_invoice" string="Generate Invoice" type="object" invisible="status != 'confirmed'"/>
          <button name="action_activate" string="Activate" type="object" invisible="status != 'paid'"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,paid,active"/>
        </header>
        <sheet>
          <group>
            <field name="partner_id"/>
            <field name="request_date"/>
            <field name="end_date"/>
            <field name="card_id"/>
            <field name="payment_term_id"/>
            <field name="invoice_id"/>
          </group>

          <notebook>
            <page string="Membership Line">
              <field name="membership_line_ids">
                <list editable="bottom">
                  <field name="product_id" domain="[('is_library_membership','=',True)]"/>
                  <field name="price_unit"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

   <!-- Action: Membership Requests -->
  <record id="action_membership_requests" model="ir.actions.act_window">
    <field name="name">Membership Requests</field>
    <field name="res_model">library.membership.request</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <!-- Action: Invoices related to Memberships -->
  <record id="action_library_membership_invoices" model="ir.actions.act_window">
    <field name="name">Membership Invoices</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('invoice_origin', 'ilike', 'Membership')]</field>
  </record>

</odoo>