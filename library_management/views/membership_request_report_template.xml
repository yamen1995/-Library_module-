<odoo>
<template id="membership_request_report_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2>Library Membership Request</h2>
          <p><strong>Name:</strong> <t t-esc="o.name"/></p>
          <p><strong>Member:</strong> <t t-esc="o.partner_id.name"/></p>
          <p><strong>Card ID:</strong> <t t-esc="o.card_id"/></p>
          <p><strong>Registration Date:</strong> <t t-esc="o.request_date"/></p>
          <p><strong>End Date:</strong> <t t-esc="o.end_date"/></p>
          <p><strong>Status:</strong> <t t-esc="o.status"/></p>
          <p><strong>Payment Terms:</strong> <t t-esc="o.payment_term_id.name"/></p>
          <p><strong>Invoice:</strong> <t t-esc="o.invoice_id.name"/></p>

          <t t-if="o.membership_line_ids">
            <h3>Membership Lines</h3>
            <table class="table table-sm table-bordered">
              <thead>
                <tr>
                  <th>supscription</th>
                  <th>currency unit</th>
                  <th>Price</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="o.membership_line_ids" t-as="line">
                <tr>
                    <td><t t-esc="line.product_id.name"/></td>
                    <td><t t-esc="o.currency_id.name"/></td>
                    <td><t t-esc="line.price_unit"/></td>
                </tr>
                </t>
              </tbody>
            </table>
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>
