<odoo>
<template id="membership_request_report_template">
  <t t-call="web.html_container">
    <t t-call="web.external_layout">
      <div class="page">
        <t t-if="o">
          <t t-set="records" t-value="[o]"/>
        </t>
        <t t-if="not o">
          <t t-set="records" t-value="docs"/>
        </t>

        <t t-foreach="records" t-as="rec">
          <div class="page">
            <h2>Library Membership Request</h2>
            <p><strong>Name:</strong> <t t-esc="rec.name"/></p>
            <p><strong>Member:</strong> <t t-esc="rec.partner_id.name"/></p>
            <p><strong>Card ID:</strong> <t t-esc="rec.card_id"/></p>
            <p><strong>Registration Date:</strong> <t t-esc="rec.request_date"/></p>
            <p><strong>End Date:</strong> <t t-esc="rec.end_date"/></p>
            <p><strong>Status:</strong> <t t-esc="rec.status"/></p>
            <p><strong>Payment Terms:</strong> <t t-esc="rec.payment_term_id.name"/></p>
            <p><strong>Invoice:</strong> <t t-esc="rec.invoice_id.name"/></p>

            <t t-if="rec.membership_line_ids">
              <h3>Membership Lines</h3>
              <table class="table table-sm table-bordered">
                <thead>
                  <tr>
                    <th>Subscription</th>
                    <th>Currency</th>
                    <th>Price</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="rec.membership_line_ids" t-as="line">
                    <tr>
                      <td><t t-esc="line.product_id.name"/></td>
                      <td><t t-esc="rec.currency_id.name"/></td>
                      <td><t t-esc="line.price_unit"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </t>
          </div>
        </t>
      </div>
    </t>
  </t>
</template>
</odoo>
